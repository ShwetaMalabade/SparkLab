# Copy to .env.local and fill in. Never commit .env.local.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_VISION=
GEMINI_MODEL_FAST=
GEMINI_MODEL_BACKUP=           # optional: tried when the main model answers 503 "high demand"
MONGODB_URI=
MONGODB_DB=homework_arena
OFFLINE=0
NEXT_PUBLIC_MOCK=1             # client API mocks until Merge 1; set 0 to go live
# Only if Amazon credits arrive (AI_PROVIDER=bedrock):
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_VISION=
BEDROCK_MODEL_FAST=
